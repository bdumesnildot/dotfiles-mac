{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux-settings.schema.json",
  "schemaVersion": 1,

  "app": {
    "minimalMode": true,
    "commandPaletteSearchesAllSurfaces": true,
    "preferredEditor": "zed",
    "reorderOnNotification": false,
    "sendAnonymousTelemetry": false,
    "warnBeforeQuit": true
  },

  "shortcuts": {
    "bindings": {
      "prevSurface": ["cmd+j", "j"],
      "nextSurface": ["cmd+j", "l"]
    },
    "showModifierHoldHints": true
  },

  "sidebar": {
    "openPullRequestLinksInCmuxBrowser": false,
    "openPortLinksInCmuxBrowser": false
  },

  "sidebarAppearance": {
    "tintColor": "#181818",
    "tintOpacity": 0.6
  },

  "browser": {
    "defaultSearchEngine": "duckduckgo",
    "insecureHttpHostsAllowedInEmbeddedBrowser": [
      "localhost",
      "127.0.0.1",
      "::1",
      "0.0.0.0",
      "*.localtest.me"
    ],
    "openTerminalLinksInCmuxBrowser": false
  }
}
