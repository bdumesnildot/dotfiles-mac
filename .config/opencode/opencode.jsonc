{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
  },
  "model": "opencode/gemini-3.5-flash",
  "agent": {
    "plan": {
      "model": "opencode/gemini-3.1-pro",
      // "model": "opencode/gemini-3.5-flash",
    },
    "build": {
      "model": "github-copilot/claude-sonnet-4.5",
      // "model": "opencode/kimi-k2.5",
    },
  },
  "mcp": {
    "linear": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
    },
    "context7": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
    },
    "figma": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3845/sse",
    },
    // "n8n-helium": {
    //   "enabled": false,
    //   "type": "remote",
    //   "url": "{file:./.secrets/N8N_HELIUM_MCP_SERVER_URL}",
    //   "headers": {
    //     "Authorization": "{file:./.secrets/N8N_HELIUM_MCP_BEARER_TOKEN}",
    //   },
    // },
  },
}
