# -----------------------------------
# GENERAL
# -----------------------------------
.old
.bak
.DS_Store
**/debug

# -----------------------------------
# SECRETS
# -----------------------------------
.env
.secrets
.ssh


# -----------------------------------
# APPS
# -----------------------------------

# CLAUDE
/claude/.config/claude/*
!/claude/.config/claude/CLAUDE.md
!/claude/.config/claude/settings.json
!/claude/.config/claude/policy-limits.json
!/claude/.config/claude/skills/

# HERDR
/herdr/.config/herdr/*
!/herdr/.config/herdr/config.toml
!/herdr/.config/herdr/.plugins.lock
!/herdr/.config/herdr/plugins.json

# KARABINER
/karabiner/.config/karabiner/automatic_backups

# ZED
/zed/.config/zed/conversations
/zed/.config/zed/prompts

# ZSH
/zsh/.zsh_history
