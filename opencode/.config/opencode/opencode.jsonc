{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
  },
  "model": "opencode/gemini-3.5-flash",
  "agent": {
    "plan": {
      "model": "github-copilot/claude-sonnet-5",
      // "model": "opencode/gemini-3.5-flash",
    },
    "build": {
      "model": "github-copilot/kimi-k2.7-code",
      // "model": "opencode/kimi-k2.5",
    },
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen3.5:latest": {
          "name": "qwen3.5:latest",
        },
      },
    },
  },
  "mcp": {
    "linear": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
    },
    "context7": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
    },
    "figma": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3845/sse",
    },
    // "n8n-helium": {
    //   "enabled": false,
    //   "type": "remote",
    //   "url": "{file:./.secrets/N8N_HELIUM_MCP_SERVER_URL}",
    //   "headers": {
    //     "Authorization": "{file:./.secrets/N8N_HELIUM_MCP_BEARER_TOKEN}",
    //   },
    // },
  },
}
